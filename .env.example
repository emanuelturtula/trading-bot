# Copy to .env for local development. NEVER commit .env (it is gitignored).
# On the Raspberry Pi these values live in ~/trading-bot-deploy/<env>/secrets.env (chmod 600).
# Only placeholders/empty values are allowed in this file.

# dev | beta | prod
TB_ENVIRONMENT=dev
TB_LOG_LEVEL=INFO
# Directory of the SQLite database and other runtime data (/app/data in the container).
# Leave commented to keep the default, which resolves under the working directory.
#TB_DATA_DIR=data

# Scheduler (operational, never secrets). Leave commented to keep the defaults.
# Seconds after the real candle close before a run fires, 0 to 900.
#TB_CANDLE_CLOSE_DELAY_SECONDS=120
# How late a missed fire may still run, 60 to 3600. It is also the startup catch-up window:
# a candle whose close is older than this is never evaluated, because there is no backfill.
#TB_SCHEDULER_MISFIRE_GRACE_SECONDS=900

# Telegram bot token from @BotFather (one bot per environment)
TB_TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot
TB_TELEGRAM_ALLOWED_CHAT_IDS=

# Dashboard authentication
TB_DASHBOARD_PASSWORD_HASH=
TB_SESSION_SECRET=
