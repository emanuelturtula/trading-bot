# Copy to .env for local development. NEVER commit .env (it is gitignored).
# On the Raspberry Pi these values live in ~/trading-bot-deploy/<env>/secrets.env (chmod 600).
# Only placeholders/empty values are allowed in this file.

# dev | beta | prod
TB_ENVIRONMENT=dev
TB_LOG_LEVEL=INFO

# Telegram bot token from @BotFather (one bot per environment)
TB_TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot
TB_TELEGRAM_ALLOWED_CHAT_IDS=

# Dashboard authentication
TB_DASHBOARD_PASSWORD_HASH=
TB_SESSION_SECRET=
